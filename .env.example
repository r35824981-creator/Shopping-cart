# Supabase project URL, for example https://your-project.supabase.co
VITE_SUPABASE_URL=

# Publishable key from Project Settings → API Keys.
# Safe to ship in the browser bundle: Row Level Security decides what it can read
# and write. Never put the secret / service_role key in a VITE_ variable.
VITE_SUPABASE_PUBLISHABLE_KEY=
